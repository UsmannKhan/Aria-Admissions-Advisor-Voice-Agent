{
  "universal_settings": {
    "crawler": {
      "user_agent": "PakAdmissionsBot/0.1 (research; FYP)",
      "rate_limit_per_domain_seconds": 1.5,
      "max_concurrent_per_domain": 2,
      "request_timeout_seconds": 60,
      "max_retries": 3,
      "retry_backoff_seconds": 5
    },
    "universal_excluded_paths": [
      "/alumni/",
      "/careers/",
      "/jobs/",
      "/gallery/",
