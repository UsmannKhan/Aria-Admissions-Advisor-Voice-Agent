      "/staff/",
      "/seecs/",
      "/sbasse/",
      "/sdsb/",
      "/mgshss/",
      "/sahsol/"
    ],
    "time_sensitive_path_patterns": [
      "/dates",
      "/schedule",
      "/critical-dates",
      "/announcements",
      "/updates",
      "/deadline"
    ],
    "cycle_markers": {
      "url_patterns": [
        "Fall\\d{4}",
        "Spring\\d{4}",
        "-fall-\\d{4}",
        "-spring-\\d{4}"
      ],
      "content_patterns": [
        "Fall 20\\d{2}",
        "Spring 20\\d{2}",
        "Academic Year 20\\d{2}-\\d{2}",
        "20\\d{2}-\\d{2} academic year",
        "cycle 20\\d{2}"
      ]
    }
  },
  "entities": {
