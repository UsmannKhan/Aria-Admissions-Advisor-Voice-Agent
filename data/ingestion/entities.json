      "type": "university",
      "display_name": "Lahore University of Management Sciences",
      "crawl": {
        "root_urls": ["https://lums.edu.pk/programmes/bs-computer-science"],
        "depth": 0,
        "allowed_domains": ["lums.edu.pk"],
        "additional_excluded_paths": [],
        "ssl_verify": true
      },
      "linked_entity_ids": []
    },
    "habib": {
      "type": "university",
      "display_name": "Habib University",
